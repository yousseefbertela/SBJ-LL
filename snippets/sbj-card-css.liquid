{%- comment -%}
  SBJ / SKIMS-match PRODUCT CARDS + PRODUCT PAGE.
  Loaded globally from layout/theme.liquid; rules are scoped to collection and
  product templates (via the data-template on #MainContent) so the homepage
  trending keeps its own rules in sbj-home-css. Pairs with the eyebrow + badge
  custom-liquid blocks in templates/collection*.json and product.json.
{%- endcomment -%}
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');
/* SKIMS title font — free "T-Star Pro Headline" lookalike (Space Grotesk).
   Overrides the heading family site-wide; eyebrow/price stay Inter like SKIMS. */
:root, body {
  --font-heading--family: "Space Grotesk", "Archivo", system-ui, sans-serif !important;
}

/* Kill Horizon's native cross-document view-transition crossfade on full page
   navigation (e.g. clicking a product card → PDP). base.css unconditionally
   opts every navigation into `@view-transition { navigation: auto }`, and
   view-transitions.js always tags it type "page-navigation" regardless of the
   page_transition_enabled theme setting — so the browser snapshots the OLD
   page and the NEW page and cross-fades them, exposing a flash of the
   destination page mid-transition before it settles. This later `@view-transition`
   rule overrides that descriptor and disables the browser-native transition
   entirely, so navigations are an instant swap — only the final styled page
   is ever visible. Same-document transitions (drawers, dialogs) are untouched;
   this only controls cross-document (full navigation) transitions. */
@view-transition {
  navigation: none;
}

/* PDP boot guard — theme.liquid adds html.sbj-boot on /products/ pages before
   first paint; sbj-pdp.liquid removes it after its first enhance() pass (gated
   CTA, cleared size, colour-name legend). Until then the variant picker + CTA
   are invisible, so the native un-enhanced state never flashes. */
html.sbj-boot [data-template^="product"] variant-picker,
html.sbj-boot [data-template^="product"] add-to-cart-component,
html.sbj-boot [data-template^="product"] product-form-component .add-to-cart-button {
  opacity: 0 !important;
}

/* SKIMS product cards have no quick-add button — just the wishlist heart.
   Hide Horizon's quick-add overlay on every product card (all pages). */
.product-card .quick-add,
.product-card quick-add-component,
.product-card .quick-add-modal,
.product-card [class*="quick-add"] {
  display: none !important;
}

/* Eyebrow — vendor label, muted grey uppercase (SKIMS).
   eyebrow_sbj (card) and eyebrow_pdp were converted from custom-liquid to a
   native "text" block bound to Product > Vendor via dynamic source
   (<p>{{ closest.product.vendor }}</p> in the block's own settings.text) —
   Product > Type is NOT a supported dynamic-source field (Shopify rejects it
   at push validation), Vendor is. Horizon renders the block as a
   <p>-wrapped div carrying `text-block--{block id}`, so these selectors key
   off the block's JSON id directly instead of a hand-added class
   (.sbj-eyebrow kept too, for we_think and anywhere else still using the
   old custom-liquid span). The <p> also needs its default margin killed. */
:is([data-template^="collection"], [data-template^="product"]) .sbj-eyebrow,
:is([data-template^="collection"], [data-template^="product"]) .text-block--eyebrow_sbj,
:is([data-template^="collection"], [data-template^="product"]) .text-block--eyebrow_pdp {
  display: block;
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 10px;
  font-weight: 500;
  line-height: 14px;
  letter-spacing: 0.25px;
  text-transform: uppercase;
  color: #6F6C69;
  margin: 10px 0 0;
}
:is([data-template^="collection"], [data-template^="product"]) .text-block--eyebrow_sbj p,
:is([data-template^="collection"], [data-template^="product"]) .text-block--eyebrow_pdp p {
  margin: 0;
}

/* Product name — clean regular-weight uppercase (SKIMS card name line is 14px/400).
   The title renders as a .text-block div whose weight comes from --font-weight
   (= --font-heading--weight, ~900); override the variable, not just font-weight. */
:is([data-template^="collection"], [data-template^="product"]) .product-card__content .user-select-text,
:is([data-template^="collection"], [data-template^="product"]) .product-card__content [class*="product_title"] {
  --font-weight: 400 !important;
  font-family: var(--font-heading--family) !important;
  font-weight: 400 !important;
  font-size: 14px !important;
  line-height: 18px !important;
  letter-spacing: 0.35px !important;
  text-transform: uppercase !important;
  color: #2D2A26 !important;
}

/* Card price — Inter, small */
:is([data-template^="collection"], [data-template^="product"]) .product-card__content .price {
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 11px !important;
  line-height: 14px !important;
  letter-spacing: 0.25px !important;
  color: #2D2A26 !important;
}

/* Badge wrapper: zero-height positioned div placed right after the gallery in DOM.
   bottom: Xpx on the badge is measured from the wrapper's top edge, which sits exactly
   at the bottom of the gallery — so the badge floats inside the image at bottom-left. */
:is([data-template^="collection"]) .sbj-badge-pos {
  position: relative;
  height: 0;
  overflow: visible;
  z-index: 2;
}
/* Best Seller / New badge — small dark label, bottom-left over the image (SKIMS position) */
:is([data-template^="collection"], [data-template^="product"]) .sbj-badge {
  position: absolute;
  bottom: 10px;
  left: 10px;
  z-index: 2;
  background: #2D2A26;
  color: #fff;
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 10px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.2px;
  padding: 6px 8px;
}

/* Swatches row — Horizon's NATIVE Swatches block (blocks/swatches.liquid,
   renders <product-swatches>); colors are admin-editable per product via
   Options > Color. The wishlist heart is a separate zero-height overlay
   block (heart_sbj) anchored to the gallery bottom so it sits on the same
   visual row, dots left / heart right (SKIMS layout). */
:is([data-template^="collection"]) .product-card product-swatches {
  margin: 8px 0 0;
  min-height: 22px;
  align-items: center;
  padding-right: 40px;   /* keep dots clear of the overlaid wishlist heart */
  box-sizing: border-box;
}
:is([data-template^="collection"]) .product-card product-swatches swatches-variant-picker-component {
  width: auto !important;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
:is([data-template^="collection"]) .product-card product-swatches overflow-list::part(list) {
  gap: 4px !important;
}
:is([data-template^="collection"]) .product-card product-swatches .variant-option__swatch {
  flex-shrink: 0;
}
:is([data-template^="collection"]) .product-card product-swatches .variant-option__button-label {
  padding: 0;
  display: block;
}
:is([data-template^="collection"]) .product-card product-swatches .swatch {
  width: 14px !important;
  height: 14px !important;
  border-radius: 2px !important;
  border: 1px solid rgba(0,0,0,0.12) !important;
  box-sizing: border-box;
}
/* SKIMS selection ring on the selected swatch. Variant-split cards
   (snippets/sbj-variant-split-cards.liquid) pre-check the card's colour;
   cards with no checked swatch fall back to ringing the first one. */
:is([data-template^="collection"]) .product-card product-swatches .variant-option__swatch:has(input:checked) .swatch,
:is([data-template^="collection"]) .product-card product-swatches:not(:has(input:checked)) .variant-option__swatch:first-child .swatch {
  outline: 1px solid #2D2A26;
  outline-offset: 1px;
}
/* Hide the native "+N" overflow count bubble — the row already truncates via
   overflow:hidden above, matching the old behaviour of just clipping. */
:is([data-template^="collection"]) .product-card product-swatches .hidden-swatches__count {
  display: none;
}
/* Wishlist heart — zero-height wrapper right after the gallery (like the
   badge), heart absolutely positioned to line up with the swatch row:
   row = 8px margin + 22px tall, icon is 18px → top 8 + (22-18)/2 = 10px. */
:is([data-template^="collection"]) .sbj-heart-pos {
  position: relative;
  height: 0;
  overflow: visible;
  z-index: 2;
}
:is([data-template^="collection"]) .sbj-heart-pos .sbj-heart {
  position: absolute;
  top: 10px;
  right: 16px;
}
/* Products with no colour swatches render no <product-swatches> at all — keep
   the row's 30px of space (8px margin + 22px row) so the heart never overlaps
   the eyebrow/title. The heart block's plain custom-liquid wrapper div is the
   element sized here. */
:is([data-template^="collection"]) .product-card div:has(> .sbj-heart-pos):not(:has(+ product-swatches)) {
  height: 30px;
}
:is([data-template^="collection"]) .sbj-heart {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  color: #2D2A26;
  line-height: 1;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  position: relative;
  z-index: 2; /* sit above .product-card__link's absolute full-card overlay */
}
:is([data-template^="collection"]) .sbj-heart svg {
  width: 18px;
  height: 18px;
  display: block;
}
/* Saved state — solid red heart (SKIMS-style wishlist red) */
:is([data-template^="collection"]) .sbj-heart.is-on svg {
  fill: #E0182B;
  stroke: #E0182B;
}

/* Force exactly 4 product columns on collection pages (SKIMS is 4-col) */
@media screen and (min-width: 750px) {
  [data-template^="collection"] .product-grid {
    --product-grid-columns-desktop: repeat(4, 1fr) !important;
  }
}

/* Taller card image to match SKIMS (~2:3 / 0.69, taller than Horizon's 4:5 portrait).
   Scoped to the MAIN product grid so the "We think you'd like" carousel keeps its own ratio. */
#MainContent[data-template^="collection"] .product-grid .card-gallery {
  --gallery-aspect-ratio: 0.69 !important;
}

/* ===== SKIMS page gutter — 24px each side on the collection content ===== */
/* SKIMS wraps heading + tiles + filters + grid in a full-width container with a
   flat 24px inline padding (no max-width). Match that. The "We think you'd like"
   carousel deliberately stays full-bleed (its own section). */

/* Filter bar: align to the 24px gutter (span all columns, drop the inset). */
#MainContent[data-template^="collection"] .facets-block-wrapper {
  grid-column: 1 / -1 !important;
  margin-inline: 0 !important;
  padding-inline: 24px !important;
  max-width: none !important;
}
/* Product grid: 24px gutter (was full-bleed). */
#MainContent[data-template^="collection"] .product-grid {
  padding-inline: 24px !important;
}
/* Collection heading: section is now full-width (template) — pad its content to the
   flat 24px gutter so the title/description align with the tiles + grid (SKIMS). */
#MainContent[data-template^="collection"] [id*="__section"] .custom-section-content {
  max-width: none !important;
  width: 100% !important;
  margin-inline: 0 !important;
  padding-inline: 24px !important;
}

/* Collection title — SKIMS "CLOTHING": 30px heavy uppercase (was ~48px). */
#MainContent[data-template^="collection"] h1 {
  font-family: var(--font-heading--family) !important;
  font-size: 30px !important;
  font-weight: 800 !important;
  line-height: 1.1 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.75px !important;
}

/* ----- Product page (PDP) — SKIMS match ------------------------------------ */
/* Eyebrow (fabric) — bold dark uppercase, sits above the name (SKIMS).
   Scoped with [data-template] so it beats the general .sbj-eyebrow rule.
   eyebrow_pdp is now a native text block (dynamic-source bound to Vendor) —
   it renders as .text-block--eyebrow_pdp, not .sbj-eyebrow--pdp. */
[data-template^="product"] .sbj-eyebrow--pdp,
[data-template^="product"] .text-block--eyebrow_pdp {
  display: inline-block;
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  line-height: 16px !important;
  letter-spacing: 0.2px !important;
  text-transform: uppercase !important;
  color: #2D2A26 !important;
  margin: 0 0 -6px !important;
  text-decoration: underline !important;
  text-decoration-thickness: 1px !important;
  text-underline-offset: 4px !important;
}
/* PDP name — heavy uppercase, 26px / 700 (SKIMS "MINI DRESS") */
[data-template^="product"] .product-details h1,
[data-template^="product"] .product-details h1 * {
  font-family: var(--font-heading--family) !important;
  font-weight: 700 !important;
  font-size: 26px !important;
  line-height: 1.1 !important;
  letter-spacing: 0.3px !important;
  text-transform: uppercase !important;
  color: #1A1A1A !important;
  margin: 0 !important;
}
/* PDP price — Inter, 16px medium */
[data-template^="product"] .product-details .price {
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 16px !important;
  font-weight: 500 !important;
  letter-spacing: 0.2px !important;
  color: #2D2A26 !important;
}
/* Details column inset — push the info right (SKIMS gutter ~48px vs our 20px)
   and lower it vertically so the block sits like SKIMS (content starts lower). */
[data-template^="product"] .product-details {
  padding-left: 40px !important;
  padding-top: 40px !important;
}
/* Tight stacked header (eyebrow/name/price) */
[data-template^="product"] .product-details .group-block-content { gap: 6px !important; }

/* Variant legends — small title-case label (SKIMS "Size" / color name) */
[data-template^="product"] .product-details .variant-option legend {
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 12px !important;
  font-weight: 600 !important;
  letter-spacing: 0.2px !important;
  text-transform: none !important;
  color: #2D2A26 !important;
  margin-bottom: 8px !important;
}
/* Size legend → "Size" + selected value grouped left, "Size Guide" pushed right (SKIMS "Size  M ... Size Guide") */
[data-template^="product"] fieldset[data-option-id$="size"] legend {
  display: flex !important;
  align-items: baseline !important;
  justify-content: flex-start !important;
  gap: 8px !important;
  width: 100% !important;
}
/* selected size value beside the label (SKIMS shows it bold/dark next to "Size") */
[data-template^="product"] .sbj-size-name {
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 12px !important;
  font-weight: 600 !important;
  letter-spacing: 0.2px !important;
  text-transform: uppercase !important;
  color: #1A1A1A !important;
}
[data-template^="product"] .sbj-size-guide {
  margin-left: auto !important;
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 12px !important;
  font-weight: 400 !important;
  letter-spacing: 0.2px !important;
  text-transform: none !important;
  color: #6F6C69 !important;
  text-decoration: underline !important;
  text-underline-offset: 3px !important;
  cursor: pointer;
  background: none;
  border: 0;
  padding: 0;
}
/* Color legend → shows the selected color name (SKIMS "Cherry Blossom"), semibold dark */
[data-template^="product"] .product-details .variant-option--swatches legend,
[data-template^="product"] fieldset[data-option-id$="color"] legend {
  font-size: 14px !important;
  font-weight: 600 !important;
  letter-spacing: 0.2px !important;
  color: #1A1A1A !important;
  margin-bottom: 12px !important;
}
[data-template^="product"] .product-details .variant-option--swatches legend .sbj-color-name,
[data-template^="product"] fieldset[data-option-id$="color"] legend .sbj-color-name {
  font-weight: 600 !important;
}
/* Native swatch mode puts "Color <value>" in the legend; the JS rewrites the
   legend to just the value (SKIMS style), so hide the native value span to
   avoid a flash of "Color Chalk Chalk" before the rewrite. */
[data-template^="product"] .product-details .variant-option--swatches legend .variant-option__swatch-value { display: none !important; }
/* Color swatch row → wider gaps like SKIMS + breathing room above (price→color) and below (before "Size") */
[data-template^="product"] .product-details .variant-option--swatches,
[data-template^="product"] .product-details fieldset[data-option-id$="color"] { gap: 12px !important; margin-top: 14px !important; margin-bottom: 30px !important; }
/* Tight flex row of option buttons (override Horizon's equal-width grid) */
[data-template^="product"] .product-details .variant-option {
  margin-bottom: 18px !important;
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 8px !important;
  align-items: center !important;
}
[data-template^="product"] .product-details .variant-option legend { flex: 0 0 100% !important; }
/* Don't let Horizon's equal-width buttons stretch — keep swatches/boxes their own size */
[data-template^="product"] .product-details .variant-option__button-label { margin: 0 !important; flex: 0 0 auto !important; }
/* Hide quantity stepper + express checkout so the CTA is full-width (SKIMS) */
[data-template^="product"] .product-details .quantity-selector-wrapper,
[data-template^="product"] .product-details .accelerated-checkout-block { display: none !important; }

/* SIZE → bordered boxes that fill the row evenly (SKIMS) */
[data-template^="product"] fieldset[data-option-id$="size"] {
  gap: 8px !important;
}
[data-template^="product"] fieldset[data-option-id$="size"] .variant-option__button-label {
  flex: 1 1 0 !important;
  min-width: 48px !important;
  max-width: 110px !important;
  height: 48px !important;
  padding: 0 8px !important;
  border: 1px solid rgba(0,0,0,0.18) !important;
  border-radius: 0 !important;
  background: #fff !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 13px !important;
  letter-spacing: 0.3px !important;
  color: #2D2A26 !important;
  cursor: pointer;
  transition: border-color .15s, background .15s, color .15s;
}
[data-template^="product"] fieldset[data-option-id$="size"] .variant-option__button-label__pill { display: none !important; }
[data-template^="product"] fieldset[data-option-id$="size"] .variant-option__button-label:hover { border-color: #2D2A26 !important; }
[data-template^="product"] fieldset[data-option-id$="size"] .variant-option__button-label:has(input:checked) {
  border-color: #2D2A26 !important;
  background: #2D2A26 !important;
  color: #fff !important;
}
[data-template^="product"] fieldset[data-option-id$="size"] .variant-option__button-label:has(input[data-option-available="false"]) {
  color: #b3b0ac !important;
  border-color: rgba(0,0,0,0.10) !important;
}

/* COLOR → square color swatches (SKIMS). Colors come from Shopify's native
   swatch system: the label wraps a .swatch element whose background is the
   linked color-pattern metaobject's hex (--swatch-background). */
[data-template^="product"] .product-details .variant-option--swatches .variant-option__button-label {
  position: relative !important;
  padding: 0 !important;
  margin: 0 !important;
  width: 30px !important;
  min-width: 30px !important;
  max-width: 30px !important;
  height: 30px !important;
  min-height: 30px !important;
  max-height: 30px !important;
  border-radius: 6px !important;
  border: 0 !important;
  background: none !important;
  overflow: hidden !important;
  display: inline-block !important;
  box-sizing: border-box !important;
  line-height: 0 !important;
  cursor: pointer;
}
[data-template^="product"] .product-details .variant-option--swatches .variant-option__button-label::before,
[data-template^="product"] .product-details .variant-option--swatches .variant-option__button-label::after { content: none !important; display: none !important; }
/* the native swatch chip fills the square label */
[data-template^="product"] .product-details .variant-option--swatches .swatch {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  border-radius: 6px !important;
  border: 1px solid rgba(0,0,0,0.12) !important;
  box-sizing: border-box !important;
}
/* Suppress default focus ring (selection shown by the checked ring/fill) */
[data-template^="product"] .product-details .variant-option__button-label,
[data-template^="product"] .product-details .variant-option__button-label:focus,
[data-template^="product"] .product-details .variant-option__button-label:focus-within,
[data-template^="product"] .product-details .variant-option__button-label input {
  outline: none !important;
  box-shadow: none !important;
}
/* Checked swatch → SKIMS selection ring */
[data-template^="product"] .product-details .variant-option--swatches .variant-option__button-label:has(input:checked),
[data-template^="product"] fieldset[data-option-id$="color"] .variant-option__button-label:has(input:checked) {
  outline: 1px solid #2D2A26 !important;
  outline-offset: 2px !important;
}
/* CTA — dark add button, capped to SKIMS width (atc-wrapper max-w-xs = 320px), left-aligned */
[data-template^="product"] .product-details add-to-cart-component { width: 100% !important; max-width: 320px !important; display: block !important; }
[data-template^="product"] .product-details .add-to-cart-button {
  width: 100% !important;
  background: #C6CBCC !important;
  color: #2D2A26 !important;
  border: 1px solid #C6CBCC !important;
  border-radius: 0 !important;
  min-height: 52px !important;
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 14px !important;
  font-weight: 500 !important;
  letter-spacing: 0.4px !important;
  text-transform: uppercase !important;
}
/* #12 — no cart/bag icon in the CTA (SKIMS is text-only) */
[data-template^="product"] .add-to-cart-button .add-to-cart-icon { display: none !important; }
/* #11 — gated "SELECT A SIZE" state: light/outlined until a size is chosen */
[data-template^="product"] .add-to-cart-button.sbj-cta--pending {
  background: #fff !important;
  color: #8A8784 !important;
  border: 1px solid #CFCCC8 !important;
  cursor: not-allowed !important;
}

/* ====== PDP MEDIA GALLERY → SKIMS single-image carousel (#1, #2, #3) ======
   Carousel mode shows one tall image with side arrows. Full-bleed to the left
   edge; overlay controls (zoom top-left, heart top-right, model-sizing
   bottom-left) layered over the active slide like SKIMS. */
[data-template^="product"] .product-media-container { position: relative; }
/* Tall image area, constrained to the viewport like SKIMS */
[data-template^="product"] .media-gallery--carousel .product-media-container,
[data-template^="product"] .media-gallery--carousel .slideshow-slide {
  background: #fff;
}
/* Show the WHOLE photo (full model, head + feet, uncropped) inside the SAME frame.
   contain (not cover) so nothing is cropped; the frame size is unchanged and any
   spare space falls back to the gallery background (white — merchant request 2026-09-13). */
[data-template^="product"] .media-gallery--carousel img {
  object-fit: contain !important;
  object-position: center !important;
  width: 100% !important;
  height: 100% !important;
}
/* Cap the image to the viewport height (SKIMS shows the whole model, no over-tall
   scroll). Width still fills the column; cover keeps the model centred. */
[data-template^="product"] .media-gallery--carousel .product-media-container {
  aspect-ratio: auto !important;
  height: calc(100vh - 96px) !important;
}
[data-template^="product"] .media-gallery--carousel .product-media,
[data-template^="product"] .media-gallery--carousel .product-media__image {
  aspect-ratio: auto !important;
  height: 100% !important;
}
/* Side arrows — large bold arrows on the image edges (SKIMS) */
[data-template^="product"] .media-gallery--carousel .slideshow-control,
[data-template^="product"] .media-gallery--carousel [ref="previous"],
