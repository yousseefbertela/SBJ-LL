{%- comment -%}
  SBJ / SKIMS-match MEGA-MENU CSS — global (all pages, header lives on every page).

  WHY A SNIPPET (read before moving it):
  Loaded once from layout/theme.liquid near </body> so it wins source-order over
  base.css :root tokens and the header block's own <style>, and so theme-editor
  saves never revert it (same pattern as sbj-footer-css / sbj-home-css).

  WHAT IT DOES (matches the SKIMS mega menu the user filmed):
   1. Makes the dropdown open/close FAST + smooth (base.css ships 360ms — too slow).
   2. Adds the "small brown animation": an animated sienna (#986B58) underline that
      slides in under the hovered / open top-level nav link (SKIMS nav-hover accent).
   3. Tightens the panel so it's "properly sized" (less cavernous vertical padding).
  Covers ONLY what native settings cannot. No HTML changes.
{%- endcomment -%}
<style>
/* ---- 1. Snappy open/close (SKIMS feel) ----------------------------------- */
/* base.css sets --submenu-animation-speed:360ms in :root; this later :root wins. */
:root {
  --submenu-animation-speed: 140ms;
}
/* A crisper ease-out so the reveal "snaps" open instead of drifting. */
#header-component .menu-list__list-item:not([slot='overflow']) > .menu-list__submenu,
#header-component .overflow-menu::part(overflow),
#header-component .header__underlay-open {
  transition-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1) !important;
}

/* ---- 1b. INSTANT hover switching (the real speed fix) -------------------- *
 * Horizon paints an invisible "safety box" (.menu-list__link[data-safety-box]
 * ::after) that overlays the area under the active link WHILE the pointer is
 * moving, so sweeping across the nav does nothing until you STOP — the freeze.
 * Killing it lets each item fire pointerenter the instant the cursor crosses
 * it, so the panel follows the cursor live in both directions (like SKIMS).
 * The small link->submenu bridge (.menu-list__list-item::after) is untouched,
 * so moving down into the open panel still keeps it open. */
#header-component .menu-list__link[data-safety-box='true']::after {
  display: none !important;
}

/* ---- 2. Brown sienna underline under top-level links ---------------------- */
#header-component {
  --sbj-nav-accent: #986B58; /* SKIMS "sienna / secondary" nav-hover underline */
}
/* The text span inside each top-level link. We anchor an underline bar to it. */
#header-component .menu-list__list-item:not([slot='overflow']) .menu-list__link-title {
  position: relative;
}
#header-component .menu-list__list-item:not([slot='overflow']) .menu-list__link-title::after {
  content: "";
  position: absolute;
  left: calc(var(--gap-xl) / 2);
  right: calc(var(--gap-xl) / 2);
  bottom: -5px;
  height: 2px;
  background: var(--sbj-nav-accent);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 180ms cubic-bezier(0.22, 0.61, 0.36, 1);
  pointer-events: none;
}
/* Slide it in on hover, keyboard focus, and while the mega panel is open. */
#header-component .menu-list__list-item:not([slot='overflow']):hover .menu-list__link-title::after,
#header-component .menu-list__list-item:not([slot='overflow']):focus-within .menu-list__link-title::after,
#header-component .menu-list__list-item:not([slot='overflow']) .menu-list__link[aria-expanded='true'] .menu-list__link-title::after {
  transform: scaleX(1);
}

/* ---- 3. Properly-sized panel + faster content fade ----------------------- */
/* base.css uses --padding-3xl top & bottom — cavernous. Trim to SKIMS proportions. */
#header-component .menu-list__submenu,
#header-component .overflow-menu::part(overflow) {
  --submenu-padding-block-start: var(--padding-lg);
  --submenu-padding-block-end: var(--padding-xl);
}
/* Content fades a touch quicker than the clip reveal so it never lags behind. */
#header-component .menu-list__list-item:not([slot='overflow']) > .menu-list__submenu,
#header-component .overflow-menu::part(overflow) {
  --submenu-content-animation: opacity calc(var(--submenu-animation-speed) * 0.6) ease-out;
}

/* ---- 4. Mega-menu content typography + featured tiles (SKIMS pic 4 look) -------
 * SKIMS panel: bold Title-Case column headings, regular Inter sub-links with roomy
 * line-height, and featured tiles that are image + title (NO price). This styles the
 * existing content to SKIMS proportions; the multi-column sub-heading structure fills
 * in once the navigation has nested groups. */

/* Column heading / standalone bold links (the L2 nav items) */
#header-component .mega-menu__link--parent,
#header-component .mega-menu__column > div > .mega-menu__link {
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  line-height: 20px !important;
  letter-spacing: normal !important;
  text-transform: none !important;
  color: #2D2A26 !important;
  margin-bottom: 10px;
}

/* Sub-links under a heading (the L3 nav items) — regular Inter, roomy */
#header-component .mega-menu__column ul .mega-menu__link {
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 14px !important;
  font-weight: 400 !important;
  line-height: 30px !important;
  letter-spacing: normal !important;
  text-transform: none !important;
  color: #2D2A26 !important;
  padding: 0 !important;
}
#header-component .mega-menu__column ul .mega-menu__link:hover {
  color: #986B58 !important; /* SKIMS sienna hover */
}

/* Featured tiles: SKIMS shows image + title only (no price). */
#header-component .mega-menu__content .price,
#header-component .mega-menu__content [class*="price"] {
  display: none !important;
}
#header-component .mega-menu__content .product-card__content .user-select-text,
#header-component .mega-menu__content .product-card__content .user-select-text :is(p, h1, h2, h3, h4, h5, h6) {
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  line-height: 18px !important;
  letter-spacing: normal !important;
  text-transform: none !important;
  color: #2D2A26 !important;
}
/* Show two featured tiles like SKIMS (hide the 3rd) and give them room. */
#header-component .mega-menu__content-list--products { gap: 18px !important; }
#header-component .mega-menu__content-list--products .mega-menu__content-list-item:nth-child(n+3) {
  display: none !important;
}

/* ==========================================================================
   5. MOBILE MENU DRAWER — juvenileeg.com look (mobile ONLY, <750px).
   Floating rounded glass card, "× Close" label, big bold top-level rows with
   native "+" accordions (drawer_accordion:true in header-group.json), and the
   featured-product strip restyled as pill chips. Desktop mega menu untouched.
   ========================================================================== */
@media screen and (max-width: 749px) {
  /* ---- The card itself: inset, rounded, frosted ---- */
  .header-drawer .menu-drawer {
    top: 10px !important;
    left: 10px !important;
    width: calc(100vw - 20px) !important;
    max-width: none !important;
    height: auto !important;
    max-height: calc(100dvh - 80px) !important;
    border: none !important;
    border-radius: 28px !important;
    background: rgba(255, 255, 255, 0.86) !important;
    backdrop-filter: blur(28px) saturate(1.4);
    -webkit-backdrop-filter: blur(28px) saturate(1.4);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.22) !important;
    padding-bottom: 20px;
  }
  /* Slide down-from-top feel instead of the full-height side sheet. */
  .header-drawer .menu-drawer {
    transform: translateY(-16px) translateX(0);
    opacity: 0;
  }
  .header-drawer .menu-open > .menu-drawer {
    transform: translateY(0) translateX(0);
    opacity: 1;
  }

  /* Blur the page behind the card (juvenile does). */
  .header-drawer .menu-drawer__backdrop {
    backdrop-filter: brightness(0.8) blur(6px);
    -webkit-backdrop-filter: brightness(0.8) blur(6px);
  }

  /* ---- "× Close" row ---- */
  .header-drawer .menu-drawer__close-button {
    display: flex !important;
    align-items: center;
    gap: 10px;
    padding: 22px 24px 6px !important;
    color: #111 !important;
  }
  .header-drawer .menu-drawer__close-button::after {
    content: 'Close';
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 17px;
    font-weight: 500;
    line-height: 1;
  }
  .header-drawer .menu-drawer__close-button svg {
    width: 18px;
    height: 18px;
  }

  /* ---- Menu list geometry ---- */
  .header-drawer .menu-drawer__menu {
    padding-inline: 24px;
  }

  /* ---- Top-level rows: BIG + bold (pic-2 headline links) ---- */
  .header-drawer .menu-drawer__menu-item--mainlist {
    min-height: 0 !important;
    padding-block: 9px !important;
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: 31px !important;
    font-weight: 700 !important;
    line-height: 1.25 !important;
    letter-spacing: -0.02em !important;
    text-transform: none !important;
    color: #111 !important;
  }

  /* The "+" expander: thin, right-aligned. Open/close morph (+ → −) is
     Horizon-native (base.css rotates the bars) — don't add transforms on top. */
  .header-drawer .menu-drawer__menu-item--mainlist > .svg-wrapper.icon-plus {
    padding-block: 0;
    padding-inline-start: var(--padding-xl);
  }
  .header-drawer .menu-drawer__menu-item--mainlist .icon-plus svg {
    width: 20px;
    height: 20px;
  }

  /* ---- Child links: small + regular, indent-free like pic 2 ---- */
  .header-drawer .menu-drawer__menu--childlist {
    padding-block: 2px 10px !important;
  }
  .header-drawer .menu-drawer__menu-item--child {
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: 16px !important;
    font-weight: 500 !important;
    line-height: 2.1 !important;
    letter-spacing: normal !important;
    text-transform: none !important;
    color: #333 !important;
    padding-block: 0 !important;
  }

  /* ---- Child links WITH photos: small rounded thumb + label rows.
     header-drawer.liquid now always renders link-featured-image for collection
     links, which also adds the --grid class (2-col, 16/9 tiles). Reshape both
     into single-column rows with a 48px square thumbnail. ---- */
  .header-drawer .menu-drawer__menu--childlist.menu-drawer__menu--grid {
    display: flex !important;
    flex-direction: column;
    gap: 2px !important;
    padding-inline-end: 0 !important;
  }
  .header-drawer .menu-drawer__menu--childlist .menu-drawer__menu-item:has(> .menu-drawer__link-image) {
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 12px;
    padding-block: 5px !important;
  }
  .header-drawer .menu-drawer__menu--childlist .menu-drawer__link-image {
    width: 48px !important;
    flex: 0 0 48px;
    aspect-ratio: 1 !important;
    height: 48px;
    object-fit: cover;
    border-radius: 14px;
  }
  /* Items in a photo list that have no image: swap the 16/9 ghost for a 48px square */
  .header-drawer .menu-drawer__menu--grid:has(.menu-drawer__link-image)
    .menu-drawer__menu-item:not(:has(> .menu-drawer__link-image)) {
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 12px;
    padding-block: 5px !important;
  }
  .header-drawer .menu-drawer__menu--grid:has(.menu-drawer__link-image)
    .menu-drawer__menu-item:not(:has(> .menu-drawer__link-image))::before {
    width: 48px !important;
    flex: 0 0 48px;
    aspect-ratio: 1 !important;
    border-radius: 14px !important;
  }

  /* ---- Featured products strip → small pill chips ---- */
  .header-drawer .menu-drawer__featured-content-list {
    gap: 10px;
    padding-block: 14px 4px;
  }
  .header-drawer .menu-drawer__featured-content-list-item--product {
    width: auto !important;
  }
  .header-drawer .menu-drawer__featured-content-list-item--product .resource-card {
    display: flex !important;
    flex-direction: row !important;
    align-items: center;
    gap: 10px;
    background: #fff;
    border-radius: 999px;
    padding: 6px 18px 6px 6px;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.06);
  }
  .header-drawer .menu-drawer__featured-content-list-item--product .resource-card__media {
    width: 44px !important;
    flex: 0 0 44px;
    aspect-ratio: 1 !important;
    --resource-card-aspect-ratio: 1 !important;
    border-radius: 999px;
    overflow: hidden;
  }
  .header-drawer .menu-drawer__featured-content-list-item--product .resource-card__content {
    padding: 0 !important;
  }
  .header-drawer .menu-drawer__featured-content-list-item--product .resource-card__title {
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    margin: 0 !important;
    white-space: nowrap;
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Chips are title+image only */
  .header-drawer .menu-drawer__featured-content-list-item--product .resource-card .price,
  .header-drawer .menu-drawer__featured-content-list-item--product .resource-card [class*='price'] {
    display: none !important;
  }
}
</style>
