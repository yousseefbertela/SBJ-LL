<style>
{%- comment -%} Medium Archivo weight for footer copy (heading font ships only 900). Global =
   the footer renders on every page, so the home category labels + brand statement use it too. {%- endcomment -%}
{{ settings.type_heading_font | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}

/* === SBJ Footer — Juvenile layout, SBJ type. All pages. ===
   Structure (sections/footer-group.json, all native blocks):
     footer-decoration  faded frosted logo behind + corner logo (sbj-footer-decoration.liquid)
     footer             group(Newsletter heading, text, email pill) | menu "Quick Links"
     footer-utilities   copyright | social icons                                        */

/* 1. Wrapper: positioning context for the decoration; white ground so the
   watermark shows through the (now transparent) section backgrounds. */
.sbj-site-footer {
  position: relative;
  overflow: hidden;
  background: var(--color-background, #fff);
}
.sbj-site-footer .shopify-section:not(.sbj-footer-decoration) {
  position: relative;
  z-index: 1;
}
.sbj-site-footer .shopify-section .section-background {
  background: transparent !important;
}
.sbj-site-footer .shopify-section :is(.section, .footer-content, .utilities) {
  background: transparent;
}

/* 2. Two columns: newsletter (wide) | quick links, links start at the page midline */
@media screen and (min-width: 990px) {
  .sbj-site-footer .footer-content {
    grid-template-columns: 1.2fr 1fr !important;
    align-items: start;
  }
  .sbj-site-footer .footer-content > .menu {
    padding-inline-start: clamp(24px, 6vw, 96px);
  }
}

/* 3. Newsletter heading — SBJ type: heading family, heavy, uppercase */
.sbj-site-footer .footer-content h2 {
  margin: 0 0 4px !important;
  font-family: var(--font-heading--family) !important;
  font-weight: 800 !important;
  font-size: 22px !important;
  line-height: 1.2 !important;
  letter-spacing: 0.75px !important;
  text-transform: uppercase !important;
  color: var(--color-foreground) !important;
}

/* 4. Newsletter copy */
.sbj-site-footer .footer-content .group-block-content p {
  margin: 0 0 8px;
  font-size: 13px;
  line-height: 1.6;
  color: var(--color-foreground);
}

/* 5. Email pill — black hairline, arrow button, full width of the column */
.sbj-site-footer .email-signup-block {
  max-width: 640px;
}
.sbj-site-footer .email-signup__input-group--integrated,
.sbj-site-footer .email-signup__input {
  border-color: #000;
}
.sbj-site-footer .email-signup__input-group--integrated {
  min-height: 56px;
}
.sbj-site-footer .email-signup__input {
  padding-inline-start: 24px;
}
.sbj-site-footer .email-signup__button--arrow,
.sbj-site-footer .email-signup__button--arrow .email-signup__button-icon {
  color: #000;
}

/* 6. Quick Links — heading matches the newsletter heading, links in body face */
.sbj-site-footer .menu__heading {
  margin-bottom: 14px;
}
.sbj-site-footer .menu__heading__default {
  font-family: var(--font-heading--family) !important;
  font-weight: 800 !important;
  font-size: 22px !important;
  line-height: 1.2 !important;
  letter-spacing: 0.75px !important;
  text-transform: uppercase !important;
}
.sbj-site-footer .menu__item {
  font-size: 13px;
  line-height: 1.4;
}
.sbj-site-footer .menu__item a {
  color: var(--color-foreground);
  text-decoration: none;
}
.sbj-site-footer .menu__item a:hover {
  text-decoration: underline;
}

/* 7. Utilities bar: © left, socials right, small type. Socials step in from the
   edge so the corner logo (decoration section) never sits on top of them. */
.sbj-site-footer [data-testid="footer-utilities"] {
  font-size: 0.75rem !important;
}
.sbj-site-footer .utilities .social-icons__wrapper {
  margin-inline-end: clamp(80px, 9vw, 140px);
}

/* 8. Mobile: stack, keep left alignment like the reference */
@media screen and (max-width: 989px) {
  .sbj-site-footer .footer-content {
    gap: 32px;
  }
  .sbj-site-footer .footer-content h2,
  .sbj-site-footer .menu__heading__default {
    font-size: 18px !important;
  }
}
</style>
