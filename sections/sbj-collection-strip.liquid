{%- comment -%}
  SBJ Collection strip — MOBILE ONLY horizontal, swipeable row of collection
  links in a solid band directly under the header (reference: Murenzo mobile
  nav strip). Items come from a menu (default: main menu) so the strip stays in
  sync with the navigation. Hidden on desktop (>= 750px).

  Layout: the section wrapper takes ZERO flow height (margin-top = header
  height, margin-bottom = -header height) and is position:sticky right under
  the header, so the strip overlays the hero (transparent, white text) and
  rides along with the sticky header. When the header sticks and goes solid
  (data-sticky-state=active) the strip switches to its "scrolled" colours.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign bg = section.settings.background_color
  if section.settings.transparent_background
    assign bg = "transparent"
  endif
  assign fg = section.settings.text_color
  assign bg_stuck = section.settings.background_color_stuck
  assign fg_stuck = section.settings.text_color_stuck
-%}

{%- if menu != blank and menu.links.size > 0 -%}
  <nav
    class="sbj-colstrip"
    aria-label="Collections"
    style="--sbj-colstrip-bg: {{ bg }}; --sbj-colstrip-fg: {{ fg }}; --sbj-colstrip-bg-stuck: {{ bg_stuck }}; --sbj-colstrip-fg-stuck: {{ fg_stuck }}; --sbj-colstrip-size: {{ section.settings.font_size }}px; --sbj-colstrip-gap: {{ section.settings.item_gap }}px; --sbj-colstrip-pad: {{ section.settings.padding_block }}px;"
  >
    <ul class="sbj-colstrip__list" role="list">
      {%- for link in menu.links -%}
        <li class="sbj-colstrip__item">
          <a
            class="sbj-colstrip__link{% if link.current %} sbj-colstrip__link--current{% endif %}"
            href="{{ link.url }}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{- link.title -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}

{% stylesheet %}
  /* Desktop: nothing rendered, nothing in flow */
  .sbj-colstrip-section {
    display: none;
  }

  .sbj-colstrip {
    background: var(--sbj-colstrip-bg, transparent);
    color: var(--sbj-colstrip-fg, #fff);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .sbj-colstrip__list {
    display: flex;
    gap: var(--sbj-colstrip-gap, 24px);
    margin: 0;
    padding: var(--sbj-colstrip-pad, 14px) 20px;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 20px;
    scrollbar-width: none;
  }

  .sbj-colstrip__list::-webkit-scrollbar {
    display: none;
  }

  .sbj-colstrip__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .sbj-colstrip__link {
    display: block;
    font-family: var(--sbj-font-ui, var(--font-body--family));
    font-size: var(--sbj-colstrip-size, 12px);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: inherit;
  }

  .sbj-colstrip__link--current {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    /* Zero-height sticky rail directly under the header. margin-top puts it
       below the (absolute, transparent) header; the negative margin-bottom
       gives that space back so the hero still starts under the header. */
    .sbj-colstrip-section {
      display: block;
      position: sticky;
      top: calc(var(--header-height, 0px) - 1px);
      height: 0;
      margin-top: var(--header-height, 0px);
      margin-bottom: calc(var(--header-height, 0px) * -1);
      z-index: calc(var(--layer-sticky, 10) - 1);
      overflow: visible;
    }

    /* Over the hero: legibility halo for white text (same idea as the header) */
    .sbj-colstrip__link {
      text-shadow: 0 0 4px rgba(0, 0, 0, 0.35), 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    /* Header stuck and solid → strip goes solid too, no halo */
    body:has(#header-component[data-sticky-state=active]) .sbj-colstrip {
      background: var(--sbj-colstrip-bg-stuck, #fff);
      color: var(--sbj-colstrip-fg-stuck, #1a1a1a);
    }

    body:has(#header-component[data-sticky-state=active]) .sbj-colstrip__link {
      text-shadow: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection strip (mobile)",
  "tag": "section",
  "class": "sbj-colstrip-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Mobile-only swipeable row of links overlaying the top of the page under the header; sticks with the header while scrolling. Hidden on desktop."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Top-level links of this menu become the strip items."
    },
    {
      "type": "header",
      "content": "Over the hero (top of page)"
    },
    {
      "type": "checkbox",
      "id": "transparent_background",
      "label": "Transparent background",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#EDEDED",
      "visible_if": "{{ section.settings.transparent_background == false }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "When scrolled (header solid)"
    },
    {
      "type": "color",
      "id": "background_color_stuck",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color_stuck",
      "label": "Text",
      "default": "#1A1A1A"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between items",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "enabled_on": {
    "templates": ["*"],
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Collection strip (mobile)"
    }
  ]
}
{% endschema %}
