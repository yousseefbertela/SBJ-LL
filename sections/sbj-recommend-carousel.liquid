{%- comment -%}
  SBJ product carousel — SKIMS match (centered title, arrows + counter top-right,
  6 cards/view, product floats on white). Used as "Trending" on home and as the
  "We think you'd like" carousel on collection + product pages.

  Product source (theme editor): pick a COLLECTION, or leave empty → all products.

  ONE CARD PER COLOR: like the collection grid, every color variant of a product
  gets its own card. Card image priority:
    1. the variant's mockup metafield (custom.mockup, file_reference image —
       the flat-lay on white the merchant uploads per color)
    2. the variant's own image
    3. the product's 2nd image, then featured image
  Products without a Color option render a single card (first variant's mockup).
  Cards WITH a mockup are listed first (pass 1), everything else follows (pass 2).
{%- endcomment -%}
{%- liquid
  assign rec_collection = section.settings.collection
  if rec_collection != blank and rec_collection.products_count > 0
    assign rec_products = rec_collection.products
  else
    assign rec_products = collections.all.products
  endif
  assign max_cards = section.settings.products_to_show
  assign card_count = 0
-%}
{%- capture heart_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20.6l-1.32-1.2C6 15.16 3 12.45 3 9.13 3 6.42 5.13 4.3 7.85 4.3c1.54 0 3.02.72 3.99 1.85a5.27 5.27 0 0 1 3.99-1.85C18.54 4.3 20.67 6.42 20.67 9.13c0 3.32-3 6.03-7.68 10.27L12 20.6z"/></svg>{%- endcapture -%}
<section class="sbj-rec" id="sbj-rec-{{ section.id }}">
  <div class="sbj-rec__head">
    <h2 class="sbj-rec__title">{{ section.settings.heading | escape }}</h2>
    <div class="sbj-rec__nav">
      <button type="button" class="sbj-rec__arrow" data-dir="-1" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <span class="sbj-rec__counter">1 / 1</span>
      <button type="button" class="sbj-rec__arrow" data-dir="1" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
  <div class="sbj-rec__track">
    {%- for pass in (1..2) -%}
    {%- for p in rec_products -%}
      {%- if card_count >= max_cards -%}{%- break -%}{%- endif -%}
      {%- liquid
        # find the Color option (same rule as the collection grid)
        assign color_option = null
        for option in p.options_with_values
          assign oname = option.name | downcase
          if oname contains 'colo'
            assign color_option = option
            break
          endif
        endfor
      -%}
      {%- if color_option -%}
        {%- for color_value in color_option.values -%}
          {%- if card_count >= max_cards -%}{%- break -%}{%- endif -%}
          {%- liquid
            # representative variant for this color: first available, else first
            assign opt_key = 'option' | append: color_option.position
            assign color_variants = p.variants | where: opt_key, color_value.name
            assign rep = color_variants | where: 'available', true | first
            if rep == null
              assign rep = color_variants | first
            endif
            if rep == null
              continue
            endif
            assign mockup = rep.metafields.custom.mockup.value
            if pass == 1 and mockup == blank
              continue
            elsif pass == 2 and mockup != blank
              continue
            endif
            assign card_img = mockup | default: rep.featured_image | default: p.images[1] | default: p.featured_image
            assign card_url = p.url | append: '?variant=' | append: rep.id
            assign card_count = card_count | plus: 1
          -%}
          {%- render 'sbj-rec-card', product: p, url: card_url, image: card_img, eyebrow: color_value.name, price: rep.price, heart_svg: heart_svg, variant_id: rep.id, color: color_value.name -%}
        {%- endfor -%}
      {%- else -%}
        {%- liquid
          assign rep = p.selected_or_first_available_variant
          assign mockup = rep.metafields.custom.mockup.value
          assign skip = false
          if pass == 1 and mockup == blank
            assign skip = true
          elsif pass == 2 and mockup != blank
            assign skip = true
          endif
          unless skip
            assign card_img = mockup | default: p.images[1] | default: p.featured_image
            assign card_count = card_count | plus: 1
          endunless
        -%}
        {%- unless skip -%}
          {%- render 'sbj-rec-card', product: p, url: p.url, image: card_img, eyebrow: p.vendor, price: p.price, heart_svg: heart_svg -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

<style>
  #sbj-rec-{{ section.id }}.sbj-rec { position: relative; width: 100%; padding: 36px 0 48px; }
  #sbj-rec-{{ section.id }} .sbj-rec__head { position: relative; text-align: center; min-height: 26px; padding: 0 40px; }
  #sbj-rec-{{ section.id }} .sbj-rec__title {
    font-family: var(--font-heading--family); font-weight: 600; font-size: 20px;
    line-height: 24px; letter-spacing: .5px; text-transform: uppercase; margin: 0; color: #2D2A26;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__nav {
    position: absolute; top: 50%; right: 40px; transform: translateY(-50%);
    display: inline-flex; align-items: center; gap: 14px;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__arrow {
    background: none; border: 0; padding: 0; cursor: pointer; width: 22px; height: 22px;
    color: #2D2A26; display: inline-flex; align-items: center; justify-content: center;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__arrow:disabled { opacity: .3; cursor: default; }
  #sbj-rec-{{ section.id }} .sbj-rec__arrow svg { width: 18px; height: 18px; }
  #sbj-rec-{{ section.id }} .sbj-rec__counter {
    font-family: "Inter","Helvetica Neue",Helvetica,Arial,sans-serif; font-size: 13px;
    font-weight: 500; letter-spacing: .3px; color: #2D2A26; min-width: 40px; text-align: center;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    margin-top: 18px; -ms-overflow-style: none; scrollbar-width: none;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__track::-webkit-scrollbar { display: none; }
  #sbj-rec-{{ section.id }} .sbj-rec__card {
    flex: 0 0 calc(100% / 6); max-width: calc(100% / 6); box-sizing: border-box;
    scroll-snap-align: start; text-decoration: none; color: inherit; position: relative;
    border-left: 1px solid #E8E5DF; border-top: 1px solid #E8E5DF; border-bottom: 1px solid #E8E5DF;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__card:first-child { border-left: none; }
  #sbj-rec-{{ section.id }} .sbj-rec__link { display: block; text-decoration: none; color: inherit; }
  #sbj-rec-{{ section.id }} .sbj-rec__media { aspect-ratio: 8 / 5; background: #fff; display: block; }
  #sbj-rec-{{ section.id }} .sbj-rec__media img {
    width: 100%; height: 100%; object-fit: contain; padding: 11%; box-sizing: border-box; display: block;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__info {
    position: relative; padding: 12px 44px 14px 24px; min-height: 76px; box-sizing: border-box;
    display: flex; flex-direction: column; gap: 2px;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__eyebrow {
    font-family: "Inter","Helvetica Neue",Helvetica,Arial,sans-serif; font-size: 10px; font-weight: 500;
    line-height: 14px; letter-spacing: .4px; text-transform: uppercase; color: #6F6C69;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__name {
    font-family: var(--font-heading--family); font-weight: 600; font-size: 14px; line-height: 18px;
    letter-spacing: .35px; text-transform: uppercase; color: #2D2A26;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__price {
    font-family: "Inter","Helvetica Neue",Helvetica,Arial,sans-serif; font-size: 10px; line-height: 14px;
    letter-spacing: .25px; color: #2D2A26; margin-top: 2px;
  }
  /* Heart = wishlist toggle button, pinned to the text area's top-right, inside the card */
  #sbj-rec-{{ section.id }} .sbj-rec__heart {
    position: absolute; right: 24px; bottom: 44px; width: 18px; height: 18px; color: #2D2A26;
    background: none; border: 0; padding: 0; margin: 0; cursor: pointer; display: block; line-height: 0;
  }
  #sbj-rec-{{ section.id }} .sbj-rec__heart svg { width: 18px; height: 18px; display: block; }
  #sbj-rec-{{ section.id }} .sbj-rec__heart.is-on svg { fill: currentColor; }
  @media (max-width: 990px) {
    #sbj-rec-{{ section.id }} .sbj-rec__card { flex-basis: calc(100% / 3); max-width: calc(100% / 3); }
  }
  @media (max-width: 749px) {
    /* Mobile: heading is centered and the carousel is swipeable — hide the
       arrows/counter so they don't overlap the heading (SKIMS mobile). */
    #sbj-rec-{{ section.id }} .sbj-rec__head { padding: 0 16px; }
    #sbj-rec-{{ section.id }} .sbj-rec__nav { display: none; }
  }
  @media (max-width: 600px) {
    #sbj-rec-{{ section.id }} .sbj-rec__card { flex-basis: calc(100% / 2); max-width: calc(100% / 2); }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('sbj-rec-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.sbj-rec__track');
    var counter = root.querySelector('.sbj-rec__counter');
    var prev = root.querySelector('[data-dir="-1"]');
    var next = root.querySelector('[data-dir="1"]');
    function pages() { return Math.max(1, Math.ceil(track.scrollWidth / track.clientWidth)); }
    function page() { return Math.min(pages(), Math.round(track.scrollLeft / track.clientWidth) + 1); }
    function render() {
      counter.textContent = page() + ' / ' + pages();
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    }
    prev.addEventListener('click', function () { track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: track.clientWidth, behavior: 'smooth' }); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(render); });
    window.addEventListener('resize', render);
    render();
  })();
</script>

{% schema %}
{
  "name": "SBJ Recommend Carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We think you'd like" },
    { "type": "collection", "id": "collection", "label": "Products from collection", "info": "Pick a collection to show its products. Leave empty to show all products. Every color of a product gets its own card, using that color's mockup image (variant metafield custom.mockup) when set." },
    { "type": "range", "id": "products_to_show", "label": "Cards to show", "min": 4, "max": 30, "step": 1, "default": 12 }
  ],
  "presets": [ { "name": "SBJ Recommend Carousel" } ]
}
{% endschema %}
