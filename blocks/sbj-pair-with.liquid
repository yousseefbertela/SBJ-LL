{%- doc -%}
  SBJ "Pair with" — small swipeable row of companion products on the product
  page (rounded grey tiles, "+" quick-add, name + price, arrows + dots).

  Which products show, in priority order:
    1. the product's own metafield  custom.pair_with  (list of products, set per
       product in Shopify admin → Products → product → Metafields → "Pair with")
    2. the block's "Products" setting in the theme editor (same list for every
       product that has no metafield)

  "+" adds the item straight to the cart: the variant in the same colour as the
  one currently selected on this page when the companion has it (else its first
  available variant). The button animates into a tick and the cart drawer opens.
{%- enddoc -%}

{%- liquid
  assign current = closest.product
  assign current_variant = current.selected_or_first_available_variant
  assign current_color = blank
  for option in current.options_with_values
    assign oname = option.name | downcase
    if oname contains 'colo'
      assign okey = 'option' | append: option.position
      assign current_color = current_variant[okey]
      break
    endif
  endfor
  assign pair_products = current.metafields.custom.pair_with.value
  if pair_products == blank or pair_products.count == 0
    assign pair_products = block.settings.products
  endif

  assign items = '' | split: ''
  for p in pair_products
    if p.id != current.id
      assign one = pair_products | where: 'id', p.id
      assign items = items | concat: one
    endif
  endfor
-%}

{%- if items.size > 0 -%}
  <div
    class="sbj-pair"
    id="sbj-pair-{{ block.id }}"
    style="--sbj-pair-per-view: {{ block.settings.per_view }}; --sbj-pair-gap: {{ block.settings.gap }}px; --sbj-pair-ratio: {{ block.settings.tile_ratio }};"
    {{ block.shopify_attributes }}
  >
    <div class="sbj-pair__head">
      <h3 class="sbj-pair__title">{{ block.settings.heading | escape }}</h3>
      <div class="sbj-pair__nav">
        <button type="button" class="sbj-pair__arrow" data-dir="-1" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button type="button" class="sbj-pair__arrow" data-dir="1" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <ul class="sbj-pair__track" role="list">
      {%- for p in items -%}
        {%- liquid
          # variant to add: same colour as the current selection when possible
          assign rep = blank
          if current_color != blank
            for option in p.options_with_values
              assign oname = option.name | downcase
              if oname contains 'colo'
                assign okey = 'option' | append: option.position
                for v in p.variants
                  if v[okey] == current_color and v.available
                    assign rep = v
                    break
                  endif
                endfor
                break
              endif
            endfor
          endif
          if rep == blank
            assign rep = p.selected_or_first_available_variant | default: p.variants.first
          endif
          assign img = rep.featured_image | default: p.featured_image
          if rep.metafields.custom.mockup.value != blank
            assign img = rep.metafields.custom.mockup.value
          endif
          assign single = p.available
        -%}
        <li class="sbj-pair__card">
          <div class="sbj-pair__tile">
            <a class="sbj-pair__tile-link" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
              {%- if img -%}
                <img src="{{ img | image_url: width: 480 }}" alt="{{ p.title | escape }}" loading="lazy" width="240" height="240">
              {%- endif -%}
            </a>
          {%- if single -%}
            <button
              type="button"
              class="sbj-pair__add"
              data-variant-id="{{ rep.id }}"
              data-product-id="{{ p.id }}"
              aria-label="Add {{ p.title | escape }} to cart"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          {%- else -%}
            <span class="sbj-pair__add sbj-pair__add--soldout" aria-label="Sold out" title="Sold out">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14"/></svg>
            </span>
          {%- endif -%}
          </div>
          <a class="sbj-pair__link" href="{{ p.url }}">
            <span class="sbj-pair__name">{{ p.title }}</span>
            <span class="sbj-pair__price">{{ p.price | money }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <div class="sbj-pair__dots" aria-hidden="true"></div>
  </div>
{%- endif -%}

{% stylesheet %}
  .sbj-pair {
    width: 100%;
    margin-top: 22px;
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #121212;
    user-select: none;   /* no text I-beam cursor over the row */
    cursor: default;
  }

  .sbj-pair__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .sbj-pair__title {
    margin: 0;
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.1px;
    text-transform: none;
  }

  .sbj-pair__nav {
    display: inline-flex;
    gap: 8px;
  }

  .sbj-pair__arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #E5E5E5;
    background: #fff;
    color: #121212;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .sbj-pair__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .sbj-pair__arrow svg {
    width: 16px;
    height: 16px;
  }

  .sbj-pair__track {
    display: flex;
    gap: var(--sbj-pair-gap, 16px);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .sbj-pair__track::-webkit-scrollbar {
    display: none;
  }

  .sbj-pair__card {
    position: relative;
    flex: 0 0 calc((100% - (var(--sbj-pair-per-view, 4) - 1) * var(--sbj-pair-gap, 16px)) / var(--sbj-pair-per-view, 4));
    scroll-snap-align: start;
  }

  .sbj-pair__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .sbj-pair__tile {
    position: relative;
    display: block;
    aspect-ratio: var(--sbj-pair-ratio, 4 / 5);
    border-radius: 16px;
    background: #F3F4F6;
    overflow: hidden;
  }

  .sbj-pair__tile-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sbj-pair__tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;   /* whole photo visible, never cropped */
    object-position: center;
  }

  .sbj-pair__name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 10px;
    min-height: calc(2 * 1.3em);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.3;
    text-transform: none;
  }

  .sbj-pair__price {
    display: block;
    margin-top: 3px;
    font-size: 13px;
    color: #6b6b6b;
  }

  /* "+" quick add, bottom-right of the tile */
  .sbj-pair__add {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 0;
    background: #fff;
    color: #121212;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .sbj-pair__add:hover {
    transform: scale(1.06);
  }

  .sbj-pair__add svg {
    width: 16px;
    height: 16px;
  }

  .sbj-pair__add--soldout {
    opacity: 0.45;
    cursor: default;
  }

  .sbj-pair__add.is-busy {
    pointer-events: none;
    animation: sbj-pair-pulse 0.8s ease-in-out infinite;
  }

  /* added → black disc, "+" rotates into a tick, pops */
  .sbj-pair__add svg {
    transition: transform 0.25s ease;
  }

  .sbj-pair__add.is-added {
    background: #121212;
    color: #fff;
    animation: sbj-pair-pop 0.35s ease;
  }

  .sbj-pair__add.is-added svg path {
    d: path("M5 12l5 5L20 7");
  }

  @keyframes sbj-pair-pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.25); }
    100% { transform: scale(1); }
  }

  @keyframes sbj-pair-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  .sbj-pair__dots {
    display: flex;
    gap: 6px;
    margin-top: 14px;
  }

  .sbj-pair__dot {
    width: 44px;
    height: 4px;
    border-radius: 2px;
    background: #E5E5E5;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .sbj-pair__dot.is-active {
    background: #6b6b6b;
  }

  @media screen and (max-width: 749px) {
    .sbj-pair__card {
      flex-basis: calc((100% - var(--sbj-pair-gap, 16px)) / 2.3);
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.getElementById('sbj-pair-{{ block.id }}');
    if (!root || root.__sbjPair) return;
    root.__sbjPair = true;
    var track = root.querySelector('.sbj-pair__track');
    var prev = root.querySelector('[data-dir="-1"]');
    var next = root.querySelector('[data-dir="1"]');
    var dots = root.querySelector('.sbj-pair__dots');

    function pages() { return Math.max(1, Math.ceil(track.scrollWidth / track.clientWidth - 0.01)); }
    function page() { return Math.min(pages(), Math.round(track.scrollLeft / track.clientWidth) + 1); }
    function render() {
      var n = pages(), cur = page();
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      if (dots.children.length !== n) {
        dots.innerHTML = '';
        for (var i = 0; i < n; i++) {
          var d = document.createElement('button');
          d.type = 'button';
          d.className = 'sbj-pair__dot';
          d.setAttribute('data-page', String(i));
          dots.appendChild(d);
        }
      }
      Array.prototype.forEach.call(dots.children, function (d, i) { d.classList.toggle('is-active', i === cur - 1); });
    }
    prev.addEventListener('click', function () { track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: track.clientWidth, behavior: 'smooth' }); });
    dots.addEventListener('click', function (e) {
      var d = e.target.closest('.sbj-pair__dot');
      if (d) track.scrollTo({ left: Number(d.getAttribute('data-page')) * track.clientWidth, behavior: 'smooth' });
    });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(render); });

    /* mouse drag scrolls the row on desktop (touch already swipes natively) */
    var drag = null;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      drag = { x: e.clientX, left: track.scrollLeft, moved: false };
      track.style.scrollSnapType = 'none';
      track.style.scrollBehavior = 'auto';
    });
    track.addEventListener('pointermove', function (e) {
      if (!drag) return;
      var dx = e.clientX - drag.x;
      if (Math.abs(dx) > 4) drag.moved = true;
      track.scrollLeft = drag.left - dx;
    });
    function endDrag() {
      if (!drag) return;
      var moved = drag.moved;
      drag = null;
      track.style.scrollSnapType = '';
      track.style.scrollBehavior = '';
      if (moved) {
        var stop = function (ev) { ev.preventDefault(); ev.stopPropagation(); track.removeEventListener('click', stop, true); };
        track.addEventListener('click', stop, true);
        setTimeout(function () { track.removeEventListener('click', stop, true); }, 50);
      }
    }
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointerleave', endDrag);
    track.addEventListener('dragstart', function (e) { e.preventDefault(); });
    window.addEventListener('resize', render);
    render();

    /* Quick add → Horizon cart (same event the product form fires, so the cart
       bubble updates and the drawer opens/refreshes) */
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('button.sbj-pair__add');
      if (!btn) return;
      e.preventDefault();
      var variantId = Number(btn.getAttribute('data-variant-id'));
      var sectionIds = [];
      document.querySelectorAll('cart-items-component').forEach(function (c) {
        if (c.dataset.sectionId) sectionIds.push(c.dataset.sectionId);
      });
      btn.classList.add('is-busy');
      fetch((window.Theme && Theme.routes && Theme.routes.cart_add_url) || '/cart/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }], sections: sectionIds.join(',') })
      })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (res.status) throw new Error(res.description || res.message || 'Could not add');
          return fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
            var ev = new CustomEvent('cart:update', { bubbles: true });
            ev.detail = {
              resource: cart,
              sourceId: btn.getAttribute('data-product-id'),
              data: {
                source: 'product-form-component',
                itemCount: 1,
                productId: btn.getAttribute('data-product-id'),
                variantId: String(variantId),
                sections: res.sections
              }
            };
            btn.dispatchEvent(ev);
            btn.classList.remove('is-busy');
            btn.classList.add('is-added');
            setTimeout(function () { btn.classList.remove('is-added'); }, 1800);
          });
        })
        .catch(function (err) { console.warn('[sbj-pair]', err); })
        .then(function () { btn.classList.remove('is-busy'); });
    });
  })();
</script>

{% schema %}
{
  "name": "Pair with",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Companion products under the product details. Per-product list: set the product's \"Pair with\" metafield in admin. The list below is used for products without one."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair with"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products (fallback)",
      "limit": 12
    },
    {
      "type": "range",
      "id": "per_view",
      "label": "Cards per view (desktop)",
      "min": 2,
      "max": 6,
      "step": 0.5,
      "default": 3.5,
      "info": "A half card at the edge shows there is more to scroll."
    },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "2 / 3", "label": "Portrait 2:3" }
      ],
      "default": "4 / 5",
      "info": "Pick the shape closest to your product photos so they fill the tile without cropping."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Pair with"
    }
  ]
}
{% endschema %}
